    "from sklearn.model_selection import StratifiedKFold, cross_val_score\n",
    "\n",
    "# 1. Configuramos un barajado (shuffle) real de los datos\n",
    "# Esto \"da la vuelta\" a la estructura actual para evitar sesgos de orden\n",
    "cv_shuffle = StratifiedKFold(n_splits=5, shuffle=True, random_state=42)\n",
    "\n",
    "# 2. Ejecutamos de nuevo el score con el modelo original (depth=3)\n",
